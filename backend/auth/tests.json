{
  "tests": [
    {
      "name": "Register new user",
      "method": "POST",
      "path": "/",
      "body": {"action": "register", "email": "test_tawus@example.com", "name": "Test User", "password": "password123"},
      "expectedStatus": 201,
      "expectedBody": {"token": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login with valid credentials",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "email": "test_tawus@example.com", "password": "password123"},
      "expectedStatus": 200,
      "expectedBody": {"token": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login with invalid credentials",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "email": "test_tawus@example.com", "password": "wrongpassword"},
      "expectedStatus": 401,
      "expectedBody": {"error": "invalid_credentials"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Session check without token",
      "method": "POST",
      "path": "/",
      "body": {"action": "session"},
      "expectedStatus": 401,
      "expectedBody": {"error": "no_token"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Unknown action",
      "method": "POST",
      "path": "/",
      "body": {"action": "unknown"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    }
  ]
}
